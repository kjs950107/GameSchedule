<Window x:Class="GameHomework.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="게임 숙제 설정"
        Icon="app.ico"
        Width="940" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="12.5">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="34"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Margin="8" SelectionChanged="Tabs_SelectionChanged">

        <!-- ===================== 게임 / 숙제 ===================== -->
        <TabItem Header="  게임 / 숙제  ">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="게임 목록" FontWeight="Bold" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="추가" Click="AddGame_Click"/>
                        <Button Content="삭제" Click="DeleteGame_Click"/>
                        <Button Content="▲" ToolTip="위로" Click="MoveGameUp_Click"/>
                        <Button Content="▼" ToolTip="아래로" Click="MoveGameDown_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LstGames" SelectionChanged="LstGames_SelectionChanged"/>
                </DockPanel>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GamePanel" Margin="0,0,8,0">

                        <GroupBox Header="게임 정보">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="이름"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtGameName" Margin="0,3" Padding="3"
                                         TextChanged="TxtGameName_TextChanged" LostFocus="TxtGameName_LostFocus"/>

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="분류"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <ComboBox x:Name="CmbGameType" Width="250" SelectionChanged="CmbGameType_SelectionChanged">
                                        <ComboBoxItem Content="모바일 게임"/>
                                        <ComboBoxItem Content="RPG (캐릭터 여러 개)"/>
                                        <ComboBoxItem Content="숙제 없는 게임 (플레이 시간만 기록)"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Hint}" Text="기한 있는 이벤트는 모바일 게임에만, 무기한 목표는 모든 게임에 등록할 수 있습니다."/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="초기화 시각"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <TextBox x:Name="TxtResetTime" Width="70" Padding="3" TextChanged="TxtResetTime_TextChanged"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="예: 04:00 · 이 게임의 모든 숙제가 이 시각에 초기화"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="주간 초기화 요일"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbWeeklyDay" Width="100" HorizontalAlignment="Left"
                                          Margin="0,3" SelectionChanged="CmbWeeklyDay_SelectionChanged"/>

                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="실행 파일" VerticalAlignment="Top" Margin="0,8,10,0"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,3">
                                    <StackPanel Orientation="Horizontal">
                                        <ListBox x:Name="LstExe" Width="220" Height="64"/>
                                        <StackPanel Margin="8,0,0,0">
                                            <Button Content="실행 중인 프로그램에서 고르기" Click="PickExe_Click" HorizontalAlignment="Left"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBox x:Name="TxtExe" Width="150" Padding="3" Margin="0,0,6,0" KeyDown="TxtExe_KeyDown"/>
                                                <Button Content="직접 추가" Click="AddExe_Click"/>
                                                <Button Content="삭제" Click="DeleteExe_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="플레이 시간 통계용. 런처가 아니라 실제 게임 실행 파일을 등록하세요. (여러 개 가능)"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox x:Name="GrpChars" Header="캐릭터">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="LstChars" Height="96" SelectionChanged="LstChars_SelectionChanged"/>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtCharName" Width="150" Padding="3" Margin="0,0,6,0"/>
                                        <Button Content="추가" Click="AddChar_Click"/>
                                        <Button Content="이름 변경" Click="RenameChar_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="삭제" Click="DeleteChar_Click"/>
                                        <Button Content="▲" ToolTip="왼쪽으로" Click="MoveCharUp_Click"/>
                                        <Button Content="▼" ToolTip="오른쪽으로" Click="MoveCharDown_Click"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="위젯에서 위쪽 캐릭터가 왼쪽 열에 표시됩니다."/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox x:Name="GrpTasks" Header="숙제">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="추가" Click="AddTask_Click"/>
                                    <Button Content="삭제" Click="DeleteTask_Click"/>
                                    <Button Content="▲" ToolTip="위로" Click="MoveTaskUp_Click"/>
                                    <Button Content="▼" ToolTip="아래로" Click="MoveTaskDown_Click"/>
                                </StackPanel>
                                <ListBox x:Name="LstTasks" Height="170" SelectionChanged="LstTasks_SelectionChanged"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox x:Name="GrpTask" Header="숙제 상세">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="숙제 이름"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtTaskName" Margin="0,3" Padding="3"
                                         TextChanged="TxtTaskName_TextChanged" LostFocus="TxtTaskName_LostFocus"/>

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="초기화 규칙"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbTaskKind" Width="220" HorizontalAlignment="Left"
                                          Margin="0,3" SelectionChanged="CmbTaskKind_SelectionChanged">
                                    <ComboBoxItem Content="매일"/>
                                    <ComboBoxItem Content="매주 (게임 주간 초기화 요일)"/>
                                    <ComboBoxItem Content="특정 요일에만 (그 요일에만 표시)"/>
                                    <ComboBoxItem Content="매월 N일"/>
                                </ComboBox>

                                <TextBlock Grid.Row="2" x:Name="LblResetDays" Style="{StaticResource FieldLabel}" Text="하는 요일"/>
                                <WrapPanel Grid.Row="2" Grid.Column="1" x:Name="PnlResetDays" Margin="0,3"/>

                                <TextBlock Grid.Row="3" x:Name="LblMonthDay" Style="{StaticResource FieldLabel}" Text="매월"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" x:Name="PnlMonthDay" Orientation="Horizontal" Margin="0,3">
                                    <TextBox x:Name="TxtMonthDay" Width="50" Padding="3" TextChanged="TxtMonthDay_TextChanged"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="일 (그 달에 없는 날짜면 말일)"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="표시 안 할 요일"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,3">
                                    <WrapPanel x:Name="PnlHiddenDays"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                               Text="체크한 요일에는 위젯에서 숨김 (예: 카게/필보 수요일). 게임 초기화 시각 기준 날짜."/>
                                </StackPanel>

                                <TextBlock Grid.Row="5" x:Name="LblScope" Style="{StaticResource FieldLabel}" Text="적용 범위"/>
                                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="CmbScope" Width="220" HorizontalAlignment="Left"
                                          Margin="0,3" SelectionChanged="CmbScope_SelectionChanged">
                                    <ComboBoxItem Content="원정대 공통 (체크 1개)"/>
                                    <ComboBoxItem Content="캐릭터마다"/>
                                </ComboBox>

                                <TextBlock Grid.Row="6" x:Name="LblTaskChars" Style="{StaticResource FieldLabel}" Text="하는 캐릭터"/>
                                <StackPanel Grid.Row="6" Grid.Column="1" x:Name="PnlTaskCharsBox" Margin="0,3">
                                    <WrapPanel x:Name="PnlTaskChars"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                               Text="체크 해제한 캐릭터에는 이 숙제 칸이 표시되지 않습니다."/>
                                </StackPanel>

                                <TextBlock Grid.Row="7" x:Name="LblCharLabels" Style="{StaticResource FieldLabel}" Text="캐릭터별 이름"
                                           VerticalAlignment="Top" Margin="0,6,10,0"/>
                                <StackPanel Grid.Row="7" Grid.Column="1" x:Name="PnlCharLabelsBox" Margin="0,3">
                                    <Grid x:Name="GridCharLabels"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                               Text="선택 사항. 예: '레이드 1' 칸을 캐릭터마다 다른 레이드 이름으로 표시"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- ===================== 이벤트 ===================== -->
        <TabItem Header="  이벤트 / 목표  ">
            <DockPanel Margin="6">
                <GroupBox DockPanel.Dock="Top" Header="이벤트 / 목표 등록">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <RadioButton x:Name="RdoDeadline" Content="기한 있는 이벤트" IsChecked="True" Margin="0,0,20,0"
                                         GroupName="EventType" Click="EventType_Click"/>
                            <RadioButton x:Name="RdoNoDeadline" Content="무기한 목표 (예: 메인스토리 깨기)"
                                         GroupName="EventType" Click="EventType_Click"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="게임"/>
                            <ComboBox x:Name="CmbEventGame" Width="190" Margin="0,0,16,0"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="마감일"/>
                            <DatePicker x:Name="DpEventEnd" Width="130" Margin="0,0,16,0"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="이름 (선택)"/>
                            <TextBox x:Name="TxtEventName" Width="170" Padding="3" Margin="0,0,10,0" KeyDown="TxtEventName_KeyDown"/>
                            <Button Content="등록" Padding="16,3" Click="AddEvent_Click"/>
                        </WrapPanel>
                        <WrapPanel x:Name="PnlQuickDates" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,8,0" Text="빠른 마감일:"/>
                            <Button Content="+3일" Click="QuickDate_Click" Tag="3"/>
                            <Button Content="+7일" Click="QuickDate_Click" Tag="7"/>
                            <Button Content="+14일" Click="QuickDate_Click" Tag="14"/>
                            <Button Content="+21일" Click="QuickDate_Click" Tag="21"/>
                            <Button Content="+28일" Click="QuickDate_Click" Tag="28"/>
                            <Button Content="+42일" Click="QuickDate_Click" Tag="42"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtEventHint" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="마감일 당일(게임 초기화 시각 기준)까지 표시, 7일 이하로 남으면 빨간 테두리. 끝나면 완료한 건 자동 삭제, 못 한 건 [놓침]으로 남아서 확인 후 삭제합니다. (모바일 게임만)"/>
                    </StackPanel>
                </GroupBox>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="완료 / 미완료 전환" Click="ToggleEventDone_Click"/>
                    <Button Content="마감일 변경 (위 날짜로)" Click="ChangeEventDate_Click"/>
                    <Button Content="이름 변경 (위 이름으로)" Click="RenameEvent_Click"/>
                    <Button Content="삭제" Click="DeleteEvent_Click"/>
                    <Separator Width="1" Margin="10,2,16,2"/>
                    <Button Content="내보내기…" ToolTip="골라서 파일로 내보내기 (다른 사람에게 공유)" Click="ExportEvents_Click"/>
                    <Button Content="가져오기…" ToolTip="받은 파일에서 추가하기 (지금 목록은 그대로)" Click="ImportEvents_Click"/>
                </StackPanel>
                <ListBox x:Name="LstEvents"/>
            </DockPanel>
        </TabItem>

        <!-- ===================== 주기 컨텐츠 ===================== -->
        <TabItem Header="  주기 컨텐츠  ">
            <DockPanel Margin="6">
                <GroupBox DockPanel.Dock="Top" Header="주기 컨텐츠 (몇 주마다 돌아오는 컨텐츠)">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="일일 · 주간 숙제나 이벤트와 따로, 4주 · 6주처럼 몇 주마다 돌아오는 컨텐츠를 관리합니다. 처음 등록할 때 '오늘부터 ○일까지'를 정하고, 다음부터는 'N주마다 ○요일까지'로 계속 돌아갑니다. 마감 7일 전부터 주기 컨텐츠 위젯에 주황색으로 표시돼요."/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="＋ 새로 등록…" Padding="14,3" Click="AddCycle_Click"/>
                            <Button Content="수정…" Click="EditCycle_Click"/>
                            <Button Content="삭제" Click="DeleteCycle_Click"/>
                            <Separator Width="1" Margin="10,2,16,2"/>
                            <Button Content="내보내기…" ToolTip="골라서 파일로 내보내기 (다른 사람에게 공유)" Click="ExportCycles_Click"/>
                            <Button Content="가져오기…" ToolTip="받은 파일에서 추가하기 (지금 목록은 그대로)" Click="ImportCycles_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <ListBox x:Name="LstCycles" MouseDoubleClick="LstCycles_MouseDoubleClick"/>
            </DockPanel>
        </TabItem>

        <!-- ===================== 픽업 ===================== -->
        <TabItem Header="  픽업  ">
            <DockPanel Margin="6">
                <GroupBox DockPanel.Dock="Top" Header="픽업 등록">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="게임"/>
                            <ComboBox x:Name="CmbPickupGame" Width="170" Margin="0,0,16,0"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="픽업"/>
                            <TextBox x:Name="TxtPickupName" Width="170" Padding="3" Margin="0,0,10,0" KeyDown="TxtPickupName_KeyDown"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="기간"/>
                            <DatePicker x:Name="DpPickupStart" Width="130"/>
                            <TextBlock Text="  ~  " VerticalAlignment="Center"/>
                            <DatePicker x:Name="DpPickupEnd" Width="130" Margin="0,0,16,0"/>
                            <Button Content="등록" Padding="16,3" Click="AddPickup_Click"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,8,0" Text="빠른 기간 (시작일부터):"/>
                            <Button Content="7일" Click="QuickPickup_Click" Tag="7"/>
                            <Button Content="14일" Click="QuickPickup_Click" Tag="14"/>
                            <Button Content="21일" Click="QuickPickup_Click" Tag="21"/>
                            <Button Content="28일" Click="QuickPickup_Click" Tag="28"/>
                            <Button Content="42일" Click="QuickPickup_Click" Tag="42"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="픽업 위젯에 게임별로 '진행 중 / 예정'이 표시됩니다. 알림은 없고, 마지막 날(게임 초기화 시각 기준)이 지나면 자동으로 삭제돼요. 목록에서 고르면 위 칸에 불러와서 고칠 수 있습니다."/>
                    </StackPanel>
                </GroupBox>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="수정 (위 내용으로)" Click="UpdatePickup_Click"/>
                    <Button Content="삭제" Click="DeletePickup_Click"/>
                    <Separator Width="1" Margin="10,2,16,2"/>
                    <Button Content="내보내기…" ToolTip="골라서 파일로 내보내기 (다른 사람에게 공유)" Click="ExportPickups_Click"/>
                    <Button Content="가져오기…" ToolTip="받은 파일에서 추가하기 (지금 목록은 그대로)" Click="ImportPickups_Click"/>
                </StackPanel>
                <ListBox x:Name="LstPickups" SelectionChanged="LstPickups_SelectionChanged"/>
            </DockPanel>
        </TabItem>

        <!-- ===================== 통계 ===================== -->
        <TabItem x:Name="TabStats" Header="  통계  ">
            <DockPanel Margin="6">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="기간"/>
                    <RadioButton x:Name="RdoStats7" Content="최근 7일" GroupName="StatsPeriod" Margin="0,0,12,0" VerticalAlignment="Center" Click="StatsOption_Changed"/>
                    <RadioButton x:Name="RdoStats28" Content="최근 4주" GroupName="StatsPeriod" Margin="0,0,12,0" VerticalAlignment="Center" IsChecked="True" Click="StatsOption_Changed"/>
                    <RadioButton x:Name="RdoStatsAll" Content="전체" GroupName="StatsPeriod" Margin="0,0,24,0" VerticalAlignment="Center" Click="StatsOption_Changed"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="게임"/>
                    <ComboBox x:Name="CmbStatsGame" Width="190" Margin="0,0,16,0" SelectionChanged="CmbStatsGame_SelectionChanged"/>
                    <CheckBox x:Name="ChkStatsPlayOnly" Content="숙제 없는 게임 포함" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" Click="StatsOption_Changed"/>
                    <Button Content="새로고침" Click="StatsOption_Changed"/>
                    <Button Content="CSV로 내보내기" Click="ExportStatsCsv_Click"/>
                    <Button Content="기록 폴더 열기" Click="OpenLogFolder_Click"/>
                </WrapPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="StatsPanel" Margin="0,0,12,12"/>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ===================== 위젯 ===================== -->
        <TabItem Header="  위젯  ">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <GroupBox Header="위젯 배치 — 끌어서 합치기 / 나누기">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="칸 하나 = 위젯 창 하나. 이름표를 다른 칸으로 끌어다 놓으면 그 위젯에 합쳐지고(넓은 위젯에 나란히), 칸이 비면 그 창은 없어집니다. 빈 칸으로 끌어 놓으면 따로 떨어져요. 같은 칸 안에서 끌면 순서가 바뀌어요. (이름표 오른쪽 클릭으로도 옮길 수 있어요)"/>
                        <UniformGrid x:Name="PnlSlots" Columns="5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="처음 상태로 (5개 따로)" Click="ResetSlots_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="위젯은 작업표시줄에 각각 표시됩니다. 작업표시줄 버튼을 누르면 잠깐 맨 앞으로 나오고, 다른 곳을 클릭하면 다시 바탕화면으로 돌아갑니다."/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="위젯별 설정 — 테마 · 배경 이미지 · 항상 위">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="위젯"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbThemeWidget" Width="320" HorizontalAlignment="Left" Margin="0,3"
                                      SelectedIndex="0" SelectionChanged="CmbThemeWidget_SelectionChanged">
                            </ComboBox>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="색 테마"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbTheme" Width="420" HorizontalAlignment="Left" Margin="0,3"
                                      SelectionChanged="CmbTheme_SelectionChanged"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="배경 이미지" VerticalAlignment="Top" Margin="0,7,10,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,3">
                                <TextBlock x:Name="TxtBgImage" Text="없음" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                <WrapPanel>
                                    <Button Content="이미지 고르기" Click="PickBg_Click"/>
                                    <Button Content="지우기" Click="ClearBg_Click"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="맞춤" Margin="10,0,6,0"/>
                                    <ComboBox x:Name="CmbImageAlign" Width="90" SelectionChanged="CmbImageAlign_SelectionChanged">
                                        <ComboBoxItem Content="위" Tag="Top"/>
                                        <ComboBoxItem Content="가운데" Tag="Center"/>
                                        <ComboBoxItem Content="아래" Tag="Bottom"/>
                                    </ComboBox>
                                </WrapPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="배경 가림 정도"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                <Slider x:Name="SldOverlay" Width="240" Minimum="0" Maximum="1" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" ValueChanged="SldOverlay_ValueChanged"/>
                                <TextBlock x:Name="TxtOverlay" Style="{StaticResource Hint}" Width="40"/>
                                <Button Content="테마 기본값" Margin="8,0,0,0" Click="ResetOverlay_Click"/>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="항상 위"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,6">
                                <CheckBox x:Name="ChkTopmost" Content="이 위젯을 항상 다른 창 위에 표시" Click="ChkTopmost_Click"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                           Text="게임 화면 위에도 떠 있어요. 전체 화면(독점) 모드 게임에서는 깜빡이거나 게임이 최소화될 수 있으니, 그런 게임은 '창 모드/테두리 없는 창'으로 쓰세요."/>
                            </StackPanel>

                            <Button Grid.Row="5" Grid.Column="1" Content="테마 · 배경을 모든 위젯에 적용" HorizontalAlignment="Left"
                                    Margin="0,4,0,0" Click="ApplyThemeAll_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="어두운 이미지 → 다크 · 밝은 이미지 → 라이트 · 사진처럼 밝고 어두운 곳이 섞인 이미지 → 글래스. 글씨가 잘 안 읽히면 '배경 가림 정도'를 올리세요. (0%면 이미지가 그대로, 100%면 테마 색만 보임)"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="표시">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="투명도"/>
                            <Slider x:Name="SldOpacity" Width="240" Minimum="0.3" Maximum="1" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" ValueChanged="SldOpacity_ValueChanged"/>
                            <TextBlock x:Name="TxtOpacity" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkLock" Content="위치/크기 잠금 (실수로 끌어서 옮기지 않도록)" Margin="0,10,0,0"
                                  Click="ChkLock_Click"/>
                        <CheckBox x:Name="ChkSortDone" Content="체크한 숙제와 다 끝낸 게임은 아래로, 남은 숙제를 위로 정렬" Margin="0,8,0,0"
                                  Click="ChkSortDone_Click"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="위젯을 주 모니터에 나란히 놓기" Click="ResetPosition_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="위젯 위쪽 제목 부분을 끌어서 원하는 모니터로 옮기세요. 오른쪽 아래 모서리로 크기를 바꿉니다. 위치는 자동 저장됩니다."/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="실행">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoStart" Content="윈도우 시작 시 자동 실행" Click="ChkAutoStart_Click"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="데이터">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="데이터 폴더 열기" Click="OpenDataFolder_Click"/>
                            <Button Content="백업 내보내기" Click="Export_Click"/>
                            <Button Content="백업 불러오기" Click="Import_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtDataPath" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
