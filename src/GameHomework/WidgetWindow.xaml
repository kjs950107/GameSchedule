<Window x:Class="GameHomework.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="게임 숙제"
        Icon="app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ShowActivated="False"
        ResizeMode="CanResizeWithGrip"
        MinWidth="260" MinHeight="160"
        Width="340" Height="600"
        FontFamily="Malgun Gothic, Segoe UI"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 테마 색 (코드에서 테마에 맞게 바꿈) -->
        <SolidColorBrush x:Key="ThemeTitle" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="ThemeText" Color="#E6E8EC"/>
        <SolidColorBrush x:Key="ThemeMuted" Color="#9AA0AA"/>
        <SolidColorBrush x:Key="ThemeIcon" Color="#B8BDC7"/>
        <SolidColorBrush x:Key="ThemeIconHover" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeIconHoverBg" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ThemeCheckBorder" Color="#7A808C"/>
        <SolidColorBrush x:Key="ThemeCheckBg" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="ThemeCheckFill" Color="#6C8CFF"/>
        <SolidColorBrush x:Key="ThemeCheckHover" Color="#AFC0FF"/>
        <SolidColorBrush x:Key="ThemeScroll" Color="#44FFFFFF"/>
        <SolidColorBrush x:Key="ThemeWindowBorder" Color="#2EFFFFFF"/>

        <!-- 제목줄 아이콘 버튼 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeIcon}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeIconHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeIconHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 체크박스 (테마 색) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4"
                                    BorderThickness="1.5" BorderBrush="{DynamicResource ThemeCheckBorder}" Background="{DynamicResource ThemeCheckBg}"
                                    VerticalAlignment="Center">
                                <Path x:Name="Mark" Data="M 3,7.5 L 6,10.5 L 11.5,4" Stroke="White"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ThemeCheckFill}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeCheckFill}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeCheckHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 얇은 스크롤바 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource ThemeScroll}" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <!-- 배경 이미지 (설정에서 고름) -->
    <Border x:Name="BgImage" CornerRadius="12"/>
    <!-- 테마 색을 이미지 위에 덮음 (가림 정도는 설정에서 조절) -->
    <Border x:Name="Root" CornerRadius="12" Background="#EB17191E" BorderBrush="{DynamicResource ThemeWindowBorder}" BorderThickness="1">
        <DockPanel x:Name="ContentRoot">
            <!-- 제목줄: 드래그로 이동 -->
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="Transparent" Padding="14,10,8,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <CheckBox x:Name="ChkPin" Content="항상 위" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                  ToolTip="이 위젯을 항상 다른 창 위에 표시" Click="ChkPin_Click"/>
                        <Button x:Name="BtnAddEvent" Style="{StaticResource IconButton}" Content="＋" ToolTip="추가" Click="AddEvent_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="⚙" ToolTip="설정" Click="Settings_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TxtTitle" Text="게임 숙제" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTitle}"/>
                        <TextBlock x:Name="TxtSummary" Foreground="{DynamicResource ThemeMuted}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="8,0,4,14" Focusable="False">
                <StackPanel x:Name="CardsPanel" Margin="0,0,4,0"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
    </Grid>
</Window>
